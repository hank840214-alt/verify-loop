{
  "your-name/my-web-app": {
    "roots": [
      "/home/you/src/my-web-app"
    ],
    "code_re": "^((src|server|tests)/.*\\.(ts|tsx|js|mjs|css|html|json)|package\\.json)$",
    "verify": "npx tsc --noEmit && npm test --silent",
    "requires": "node_modules",
    "limit": 300,
    "tests_re": "^tests/|\\.test\\.(ts|tsx|js|mjs)$",
    "edit_check": {
      "files_re": "^(src|server)/.*\\.(ts|tsx)$",
      "cmd": "npx tsc --noEmit --pretty false",
      "limit": 15
    },
    "handback_verify": "npx tsc --noEmit && npm test --silent",
    "handback_limit": 420
  },
  "your-name/my-db-app": {
    "roots": [
      "/home/you/src/my-db-app"
    ],
    "code_re": "^((src|tests|prisma)/.*\\.(ts|tsx|sql|prisma)|package\\.json)$",
    "verify": "T=$(mktemp -d) && trap 'rm -rf \"$T\"' EXIT && export DATABASE_URL=\"file:$T/test.db\" && case \"$DATABASE_URL\" in *dev.db*|*prod*) exit 99;; esac && npx prisma migrate deploy && npx jest --runInBand",
    "requires": "node_modules",
    "limit": 300,
    "tests_re": "^tests/|\\.test\\.(ts|tsx|js|mjs)$"
  }
}
