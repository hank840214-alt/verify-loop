{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-verify.sh\"", "timeout": 600 } ] }
    ],
    "PreToolUse": [
      { "matcher": "SubagentHandback", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-verify.sh\"", "timeout": 480 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-verify.sh\"", "timeout": 480 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-check.sh\"", "timeout": 30 } ] }
    ]
  }
}
